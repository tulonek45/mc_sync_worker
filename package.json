{
  "name": "mc_sync_worker",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "dev:e2e": "wrangler dev --env e2e --remote",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:e2e": "wrangler deploy --env e2e",
    "generate:p:vanilla": "node scripts/generate_profile.cjs --profile vanilla",
    "generate:p:test": "node scripts/generate_profile.cjs --profile test",
    "publish:p:vanilla": "node scripts/publish_profile.cjs --profile vanilla",
    "publish:p:vanilla:e2e": "node scripts/publish_profile.cjs --env e2e --profile vanilla",
    "publish:p:test": "node scripts/publish_profile.cjs --env e2e --profile test",
    "register:discord": "node scripts/register_commands.cjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "seed:e2e:auth": "node scripts/seed_e2e_auth.cjs",
    "e2e:auth": "node test/e2e/test_auth.cjs",
    "e2e:latest": "node test/e2e/test_latest.cjs",
    "e2e:commit": "node test/e2e/test_commit.cjs",
    "e2e:lock": "node test/e2e/test_lock.cjs",
    "e2e:lock:a": "node test/e2e/test_lock.cjs a",
    "e2e:lock:h": "node test/e2e/test_lock.cjs h",
    "e2e:lock:r": "node test/e2e/test_lock.cjs r",
    "e2e:profile": "node test/e2e/test_profile.cjs",
    "log": "wrangler tail --env=\"\"",
    "log:e2e": "wrangler tail --env e2e"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "aws4fetch": "^1.0.20",
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.163.0"
  }
}
